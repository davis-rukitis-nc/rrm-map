	<gx:CascadingStyle kml:id="__managed_style_13D401E78D3F3CA62D71_highlight">
		<Style>
			<IconStyle>
				<scale>1.2</scale>
				<Icon>
					<href>data:image/png;base64,</href>
				</Icon>
			</IconStyle>
			<LabelStyle>
			</LabelStyle>
			<LineStyle>
				<color>ff2dc0fb</color>
				<width>6</width>
			</LineStyle>
			<PolyStyle>
				<color>40ffffff</color>
			</PolyStyle>
			<BalloonStyle>
				<text><![CDATA[<div style="background:#FFFFFF;border:0.0625rem solid rgba(89,52,78,0.14);border-radius:1rem;overflow:hidden;"><div style="padding:0.9rem 1rem;background:rgba(242,223,182,0.22);border-bottom:0.0625rem solid rgba(89,52,78,0.08);"><h3 style="margin:0;font-size:1.1rem;line-height:1.25;font-weight:normal;color:#59344E;">Opening hours</h3></div><div style="padding:1rem;display:flex;flex-wrap:wrap;gap:0.75rem;"><div style="flex:1 1 16rem;min-width:14rem;background:#F9EACD;border:0.0625rem solid rgba(89,52,78,0.08);border-radius:0.9rem;padding:0.9rem;box-sizing:border-box;"><p style="margin:0 0 0.35rem 0;font-size:0.95rem;line-height:1.3;color:#59344E;">Friday, May 15, 2026</p><h4 style="margin:0;font-size:1.25rem;line-height:1.2;font-weight:normal;color:#CC2328;">10:00–20:00</h4></div><div style="flex:1 1 16rem;min-width:14rem;background:#F9EACD;border:0.0625rem solid rgba(89,52,78,0.08);border-radius:0.9rem;padding:0.9rem;box-sizing:border-box;"><p style="margin:0 0 0.35rem 0;font-size:0.95rem;line-height:1.3;color:#59344E;">Saturday, May 16, 2026</p><h4 style="margin:0;font-size:1.25rem;line-height:1.2;font-weight:normal;color:#CC2328;">10:00–20:00</h4></div></div></div>]]></text>
			</BalloonStyle>
		</Style>
	</gx:CascadingStyle>
